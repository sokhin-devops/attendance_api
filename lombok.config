# Root of the Lombok configuration tree for this module.
config.stopBubbling = true

# Generated code (builders, getters, setters, equals/hashCode) carries Spring's
# @NonNull/@Nullable annotations. Without this, Eclipse JDT null analysis reports
# "needs unchecked conversion to conform to '@NonNull X'" every time a Lombok-built
# object is passed into Spring Data, whose packages are @NonNullApi by default.
lombok.addNullAnnotations = spring

# Keep generated members out of test-coverage reports.
lombok.addLombokGeneratedAnnotation = true
